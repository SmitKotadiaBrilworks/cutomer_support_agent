# Copy this file to `.env` in the same directory and fill in whichever keys
# you have. Only ONE is required to run the demo — the app auto-detects which
# providers are configured and builds the fallback chain from those
# (OpenAI -> Anthropic -> Google, skipping any that are missing).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional overrides — verified 2026-09-14 (OpenAI via web search, no key to
# test live; Google via live calls, both models.list() and an actual
# invoke(); Anthropic from this session's own context). Re-verify before a
# demo: Google's lineup alone has moved from 2.0 to 3.8 in under a year, and
# our old gemini-2.0-flash default had already been fully removed from the
# API by the time this was checked.
#
# Pinned deliberately, not "-latest" aliases: gemini-flash-latest currently
# points at a newer Gemini generation that returns replies as structured
# content blocks instead of a plain string, which breaks this app's response
# handling — confirmed live, not theoretical. An alias silently changing
# response *shape* is worse than a model simply going away, since it doesn't
# fail loudly.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_MODEL=gemini-2.5-flash

# --- Optional production-infra mode -----------------------------------
# Default (unset / "memory"): in-process mock data + in-memory conversation
# state. Zero setup, nothing external to run.
#
# "postgres": real Postgres (orders/tickets/users/audit log) + pgvector
# semantic FAQ search + Redis-backed conversation memory. Requires
# `docker compose up -d` from the project root and a one-time
# `python -m scripts.seed_postgres`. See README.md.
STORE_BACKEND=memory

DATABASE_URL=postgresql://urbancart:urbancart@localhost:5433/urbancart
REDIS_URL=redis://localhost:6380

# All tables live inside this Postgres schema, not `public` — safe to point
# DATABASE_URL at a Postgres instance / Supabase project that already has
# other tables in it (a different app, a different POC, etc). Only change
# this if "urbancart" itself happens to collide with something you have.
POSTGRES_SCHEMA=urbancart

# Using Supabase instead of the local docker-compose Postgres? DATABASE_URL
# is the ONLY thing that changes — this app talks raw Postgres (psycopg), not
# Supabase's REST API, so the anon/service_role API keys are not needed here.
# From your Supabase project: Project Settings -> Database -> Connection
# string. Prefer the "Transaction pooler" string (port 6543) over the direct
# connection — direct connections are IPv6-only in most Supabase regions and
# often unreachable from a typical dev network/CI runner. The transaction
# pooler is pgbouncer-based (no server-side prepared statements), which this
# app already accounts for. `sslmode=require` in the string is fine as-is.
# Redis still runs separately (local Docker, or a hosted Redis like Upstash)
# — Supabase only replaces the Postgres piece.

# Which provider computes FAQ embeddings in postgres mode. Defaults to
# OpenAI if OPENAI_API_KEY is set, else Google. Anthropic has no public
# embeddings API, so it's never used here even if it's your chat provider.
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
